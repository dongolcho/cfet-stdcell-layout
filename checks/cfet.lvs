# KLayout LVS deck for CFET 4T and 3T cells drawn with the cfet.lyp layers.
#
# Usage:
#   klayout_app.exe -b -r cfet.lvs -rd input=<layout.gds> -rd report=<report.lvsdb>
#                   (-rd netlists=<folder> | -rd schematic=<netlist.cir>) [-rd cell=<top cell>]
#
# With netlists=<folder>, the schematic is <folder>/<cell>_4t.cir or <cell>_3t.cir,
# chosen by the prBoundary height (84 nm for 4T, 63 nm for 3T).
#
# Device model: every gate column holds one pFET in the bottom tier and one nFET in the top tier.
# Both tiers share the FININTENT and PO1 shapes, so each tier gets its own copy of the channel
# layers; the bottom copy connects only to M0bot and the top copy only to M0top.
# Layout pins are texts on MINTINTENT or M1 (signals) and on MBURINTENT (VDD, VSS).

source($input, $cell)
report_lvs($report)
deep

# Reads SPICE "M" elements (D G S B) as 3-terminal MOS devices; CFET tiers have no body terminal.
class Mos3SpiceReader < RBA::NetlistSpiceReaderDelegate
  def element(circuit, element_type, name, model, value, nets, params)
    if element_type != "M" || nets.size != 4
      return super
    end
    device_class = circuit.netlist.device_class_by_name(model)
    if !device_class
      device_class = RBA::DeviceClassMOS3Transistor::new
      device_class.name = model
      circuit.netlist.add(device_class)
    end
    device = circuit.create_device(device_class, name)
    device.connect_terminal("D", nets[0])
    device.connect_terminal("G", nets[1])
    device.connect_terminal("S", nets[2])
    # SPICE values are in meters; KLayout MOS parameters are in micrometers.
    device.set_parameter("L", (params["L"] || 0.0) * 1e6)
    device.set_parameter("W", (params["W"] || 0.0) * 1e6)
    true
  end
end

bpr        = input(1, 0)
fin        = input(2, 0)
gate       = input(10, 0)
m0bot      = input(20, 0)
m0top      = input(21, 0)
m0merge    = input(22, 0)
vbur_short = input(30, 0)
vbur_tall  = input(31, 0)
vbot       = input(40, 0)
vtop       = input(41, 0)
vintga     = input(42, 0)
mint       = input(50, 0)
v1         = input(60, 0)
m1         = input(61, 0)
supervia   = input(62, 0)
mint_text  = labels(50, 0)
m1_text    = labels(61, 0)
bpr_text   = labels(1, 0)
boundary   = input(100, 0)

# ---- schematic netlist: given directly, or chosen by the cell height ----
NETLIST_SUFFIX_BY_HEIGHT = { 84 => "4t", 63 => "3t" }
schematic_path = $schematic
if !schematic_path
  if !$netlists
    raise "Error: missing schematic for '#{$input}'. LVS was not run. Pass -rd netlists=<folder> or -rd schematic=<netlist.cir>."
  end
  if boundary.is_empty?
    raise "Error: missing prBoundary (layer 100/0) in '#{$input}'. LVS reads the cell height from it to choose the schematic and was not run. Draw the cell outline on prBoundary."
  end
  height_nm = (boundary.data.bbox.height * dbu * 1000).round
  suffix = NETLIST_SUFFIX_BY_HEIGHT[height_nm]
  if !suffix
    raise "Error: invalid prBoundary height #{height_nm} nm in '#{$input}'. No schematic is assigned to this height; LVS was not run. Draw prBoundary 84 nm high (4T) or 63 nm high (3T)."
  end
  schematic_path = File.join($netlists, "#{source.cell_name}_#{suffix}.cir")
end
if !File.exist?(schematic_path)
  raise "Error: missing schematic netlist '#{schematic_path}'. LVS was not run. Add the netlist, or pass another one with -rd schematic=<netlist.cir> (run_checks.ps1: -Schematic)."
end

# Separate copies per tier, so that the two tiers are not connected through the shared shapes.
pfet_channel = fin & gate
nfet_channel = fin & gate
pfet_sd = fin - gate
nfet_sd = fin - gate

extract_devices(mos3("PMOS"), { "SD" => pfet_sd, "G" => pfet_channel, "tS" => pfet_sd, "tD" => pfet_sd, "tG" => gate })
extract_devices(mos3("NMOS"), { "SD" => nfet_sd, "G" => nfet_channel, "tS" => nfet_sd, "tD" => nfet_sd, "tG" => gate })

connect(pfet_sd, m0bot)
connect(nfet_sd, m0top)
connect(m0bot, m0merge)
connect(m0merge, m0top)
connect(m0bot, vbot)
connect(vbot, mint)
connect(m0top, vtop)
connect(vtop, mint)
connect(gate, vintga)
connect(vintga, mint)
connect(m0bot, vbur_short)
connect(vbur_short, bpr)
connect(m0top, vbur_tall)
connect(vbur_tall, bpr)
connect(mint, v1)
connect(v1, m1)
connect(gate, supervia)
connect(supervia, m1)
connect(mint, mint_text)
connect(m1, m1_text)
connect(bpr, bpr_text)

schematic(schematic_path, RBA::NetlistSpiceReader::new(Mos3SpiceReader::new))

netlist.simplify
schematic.simplify
align

# simplify removes a circuit without devices, and compare then has nothing to report as different.
layout_circuit = netlist.circuit_by_name(source.cell_name)
# compare matches the top circuit by its devices and does not require each schematic pin to exist
# in the layout. A pin text on a shape that reaches no transistor is removed with its floating net,
# so the layout circuit lacks that pin; list such pins explicitly.
schematic_circuit = schematic.circuit_by_name(source.cell_name)
missing_pins = []
if layout_circuit && schematic_circuit
  missing_pins = schematic_circuit.each_pin.map(&:name) - layout_circuit.each_pin.map(&:name)
end

if !layout_circuit
  puts("Error: missing transistors in cell '#{source.cell_name}' of '#{$input}'. LVS did not compare it with the schematic. Draw PO1 gates across FININTENT.")
elsif !compare
  puts("Error: LVS found differences between the layout '#{$input}' and the schematic '#{schematic_path}'. Open #{$report} in KLayout (Tools > Netlist Browser) to see them.")
elsif !missing_pins.empty?
  names = missing_pins.map { |name| "'#{name}'" }.join(", ")
  puts("Error: missing #{missing_pins.size == 1 ? 'pin' : 'pins'} #{names} in cell '#{source.cell_name}' of '#{$input}'. " \
       "The transistors match the schematic, but no text with #{missing_pins.size == 1 ? 'this name' : 'these names'} sits on a net that reaches them. " \
       "Place each text on MINTINTENT or M1 (VDD, VSS on MBURINTENT) over the shape that connects to its gate or S/D.")
else
  puts("Info: LVS found the layout of '#{$input}' equal to the schematic '#{schematic_path}'.")
end
